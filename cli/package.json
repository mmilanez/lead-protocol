{
  "name": "@leadsolutions/lead-protocol",
  "version": "2.1.3",
  "description": "CLI tooling for the Lead Protocol — multi-agent coordination framework",
  "type": "module",
  "bin": {
    "lead-protocol": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/session-lifecycle.test.mjs",
    "test:pack": "node scripts/test-pack.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "lead-protocol",
    "ai-agents",
    "multi-agent",
    "coordination",
    "handoff",
    "cli"
  ],
  "author": "Lead Protocol",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmilanez/lead-protocol.git",
    "directory": "cli"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "chalk": "^5.4.0",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
